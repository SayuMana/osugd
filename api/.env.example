PORT=3001
WEB_ORIGIN=http://localhost:5173

OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
OSU_REDIRECT_URI=http://localhost:3001/api/auth/callback

SESSION_SECRET=

# osu user id pemilik log
OWNER_OSU_ID=
# id yang boleh masuk sebagai admin, pisah pakai koma
ADMIN_OSU_IDS=

# dipakai /api/cron/sync; kalau kosong endpoint-nya mati (404)
CRON_SECRET=
# nyalakan fitur request di production
REQUESTS_ENABLED=

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# opsional: rate limit global antar instance (Upstash Redis REST).
# kosong = limiter jatuh ke in-memory per proses, cukup untuk lokal.
# nama KV_REST_API_* juga dikenali (itu yang dipasang integrasi Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
